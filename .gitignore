# Lista blanca: solo se versiona lo listado. Algo nuevo en la raíz se agrega aquí (si no, queda fuera sin aviso).
/*
!/.gitignore
!/.github/
!/.claude/
!/bin/
!/ui/
!/docs/
!/herramientas/
!/pruebas/
!/escritorio/
!/movil/
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/LICENSE
!/build.sh
!/instalar.sh
# Pieza: la descripción de la app, las piezas que tiene y las acciones que atiende el host.
!/app.json
!/piezas.json
!/acciones.json
# Despeja no tiene más carpetas propias en la raíz (poc/ es local: la prueba de concepto no se sube).
escritorio/target/
escritorio/gen/
escritorio/vendor/
movil/node_modules/
node_modules/
dist/
__pycache__/
.terminos-privados
capturas/
.DS_Store

# Xcode: lo de cada persona (ventanas, esquemas, el equipo elegido) nunca va al repo.
movil/ios/App.xcodeproj/xcuserdata/
movil/ios/App.xcodeproj/project.xcworkspace/
