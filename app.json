{
 "nombre": "Despeja",
 "id": "despeja",
 "version": "0.1.0",
 "repo": "despeja-app/despeja",
 "datos": "sistema",
 "icono": "docs/favicon.svg",
 "plataformas": [
  "mac",
  "ios"
 ],
 "config": {
  "idioma_ui": [
   "es",
   "en"
  ],
  "bienvenida": "bool",
  "ia": [
   "claude",
   "codex",
   "gemini"
  ],
  "tema": [
   "sistema",
   "claro",
   "oscuro"
  ],
  "carpeta": {
   "tipo": "texto",
   "max": 4000,
   "interfaz": false
  }
 },
 "empaquetado": {
  "descripcion": "Deja tu iPhone solo con lo necesario: catastro, respaldo y limpieza, con tu propia IA.",
  "categoria": "public.app-category.utilities",
  "linux_categoria": "Utility",
  "carpetas": [],
  "permisos": [],
  "ocupada": []
 },
 "acciones": {
  "iphoneEstado": {
   "script": "iphone.py",
   "args": [
    "estado"
   ],
   "datos": {},
   "responde": "iphoneEstado",
   "limite": 60
  },
  "iphoneApps": {
   "script": "iphone.py",
   "args": [
    "apps"
   ],
   "datos": {},
   "responde": "iphoneApps",
   "limite": 900
  },
  "respaldoRecibir": {
   "script": "respaldo.py",
   "args": [
    "recibir"
   ],
   "entrada": "archivo",
   "datos": {},
   "inyectar": {
    "destino": "carpetaActual"
   },
   "limite": "trabajo",
   "progreso": "respaldoProgreso",
   "responde": "respaldoTerminado"
  },
  "respaldoDetener": {
   "script": "respaldo.py",
   "args": [
    "detener"
   ],
   "datos": {},
   "responde": "respaldoDetenido",
   "limite": 15
  },
  "iphoneDesinstalar": {
   "script": "iphone.py",
   "args": [
    "desinstalar"
   ],
   "entrada": "archivo",
   "datos": {
    "id": {
     "tipo": "texto",
     "max": 200
    }
   },
   "eco": [
    "id"
   ],
   "responde": "appDesinstalada",
   "limite": 120
  },
  "iosRevisar": {
   "script": "plan.py",
   "args": [
    "ios"
   ],
   "datos": {},
   "responde": "iosRevisado",
   "limite": 60
  },
  "planArmar": {
   "script": "plan.py",
   "args": [
    "armar"
   ],
   "entrada": "archivo",
   "datos": {},
   "inyectar": {
    "idioma": "idiomaUI"
   },
   "responde": "planListo",
   "limite": 400
  },
  "appsSugerir": {
   "script": "plan.py",
   "args": [
    "sugerir"
   ],
   "entrada": "archivo",
   "datos": {},
   "inyectar": {
    "idioma": "idiomaUI"
   },
   "responde": "appsSugeridas",
   "limite": 300
  }
 },
 "ios": {
  "permisos": [
   {
    "clave": "NSPhotoLibraryUsageDescription",
    "texto": "Para revisar tus fotos y videos y respaldarlos en tu Mac antes de borrar algo."
   },
   {
    "clave": "NSLocalNetworkUsageDescription",
    "texto": "Para conectarte con Despeja en tu Mac por tu Wi-Fi, sin pasar por internet."
   }
  ],
  "bonjour": [
   "despeja"
  ]
 },
 "ia": {
  "ayuda": "Revisa en Ajustes → Tu IA."
 }
}
